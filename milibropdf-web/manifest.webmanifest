{
  "name": "MiLibroPDF — Tu biblioteca personal",
  "short_name": "MiLibroPDF",
  "description": "Tu biblioteca personal para leer, escuchar y estudiar PDF y EPUB desde cualquier dispositivo.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F7F1E6",
  "theme_color": "#5B2140",
  "categories": ["books", "education", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"], "application/epub+zip": [".epub"] } }
  ]
}
